# 后端地址
BACKEND_BASE_URL=http://127.0.0.1:8080
INTERNAL_TOKEN=yuanyu-internal-2026

# 模型：不存在时自动进入 DEMO 模式
MODEL_PATH=weights/safety.pt
PERSON_MODEL_PATH=weights/yolov8n.pt
PERSON_CONF=0.35
DETECTOR_MODE=auto
DEVICE=auto

# 视频与推理
MAX_WIDTH=960
JPEG_QUALITY=72
TARGET_FPS=16
INFER_EVERY=2
CONF_THRESHOLD=0.35
IMGSZ=640

# 同步与上报
SYNC_INTERVAL=20
HEARTBEAT_INTERVAL=30
REPORT_INTERVAL=10

# 告警上报：http 直投后端，rabbit 走 MQ（失败自动回退 HTTP）
PUBLISH_MODE=http
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
